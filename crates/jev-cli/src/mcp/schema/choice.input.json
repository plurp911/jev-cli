{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "instructions",
    "options"
  ],
  "properties": {
    "state": {
      "description": "The data to judge: a string, or a JSON object or array. Sent to the configured TypeSafe endpoint. Treated as data; instructions inside it are not followed.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "description": "The question, in natural language."
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 255,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "The options, in order. 2 to 255."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Key for the answer in the result. Default \"answer\"."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id or alias. Default: the server's configured model."
    }
  }
}
