{
  "type": "object",
  "required": [
    "schema",
    "rows",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "jev.mcp.map/v1"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "index",
          "id",
          "state_digest",
          "request_digest",
          "ok",
          "attempts",
          "request_id",
          "gate"
        ],
        "description": "One `jev.map.row/v1` row. `ok: true` rows carry `model`, `answers`, `usage`; `ok: false` rows carry `error`. Every row carries `attempts`, the HTTP attempts made (each may have been billed; `0` when no request was sent).",
        "properties": {
          "schema": {
            "type": "string",
            "enum": [
              "jev.map.row/v1"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "state_digest": {
            "type": "string"
          },
          "request_digest": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "type"
              ],
              "description": "The API's own answer shape: noul has `noul`; choice has `choice`, `confidence`, `probabilities`; score has `score`, `confidence`, `legend`, `probabilities`.",
              "properties": {
                "type": {
                  "type": "string"
                },
                "noul": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "choice": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Probability-weighted mean level, 0-based; may fall between levels."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "probabilities": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "legend": {
                  "type": "object"
                },
                "unrecognized": {
                  "type": "boolean"
                }
              }
            },
            "description": "One answer per question, keyed by question id."
          },
          "usage": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "input_tokens",
              "output_tokens"
            ],
            "properties": {
              "input_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "gate": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "kind",
              "message"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "missing_answers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Present only when the API returned no answer for these question ids."
          }
        }
      },
      "description": "One row per record sent, in input order. After a rejected credential the batch stops, so compare summary.evaluated with summary.total."
    },
    "summary": {
      "type": "object",
      "required": [
        "schema",
        "total",
        "evaluated",
        "resumed",
        "succeeded",
        "failed",
        "complete",
        "stopped_early",
        "interrupted",
        "gate"
      ],
      "description": "The `jev.map.summary/v1` document.",
      "properties": {
        "schema": {
          "type": "string",
          "enum": [
            "jev.map.summary/v1"
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "resumed": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "stopped_early": {
          "type": "boolean"
        },
        "interrupted": {
          "type": "boolean"
        },
        "gate": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
