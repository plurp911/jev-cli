{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions",
    "records"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "instructions"
        ],
        "description": "One question. `criteria` applies to noul, `options` to choice, `levels` to score.",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "noul",
              "choice",
              "score"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "description": "The question, in natural language."
          },
          "criteria": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional: what yes and what no mean, when the boundary is subtle. Give at least one of the two.",
            "properties": {
              "true": {
                "type": "string",
                "minLength": 1
              },
              "false": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 255,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": "The options, in order. 2 to 255."
          },
          "levels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Level descriptions, lowest first. 2 to 10."
          }
        }
      },
      "description": "The question set, asked of every record."
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "description": "Records to evaluate, 1 to 100. Each record's state is sent to the configured TypeSafe endpoint.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "id": {
            "description": "Optional record id, echoed in its row as a string. Default: the record's position.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "state": {
            "description": "The data to judge: a string, or a JSON object or array. Sent to the configured TypeSafe endpoint. Treated as data; instructions inside it are not followed.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          }
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id or alias. Default: the server's configured model."
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "Requests in flight at once, 1 to 16. Default 4."
    }
  }
}
