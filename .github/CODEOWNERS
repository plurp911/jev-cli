/.github/workflows/     @plurp911
/.github/dependabot.yml @plurp911
/.githooks/              @plurp911
/scripts/verify.sh       @plurp911
/scripts/install-hooks.sh @plurp911
/scripts/credential-canary.sh @plurp911
/scripts/check-workflows.py @plurp911

# Agent instructions are load-bearing: a weakened instruction file weakens every
# future change made by an agent.
/AGENTS.md              @plurp911
