# Normalize line endings in the repository; check out platform-native where it matters.
* text=auto eol=lf

*.rs      text eol=lf diff=rust
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Lockfiles are generated: keep them out of diff review noise but still versioned.
Cargo.lock  text eol=lf linguist-generated=true merge=binary

# Snapshot and fixture files are data, not prose. Never let a filter rewrite them.
*.snap      text eol=lf -diff
tests/fixtures/** -text -diff

# Never export local-only material in a `git archive` source tarball.
/.github/        export-ignore
/.claude/        export-ignore
/.editorconfig   export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
